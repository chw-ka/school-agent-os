# =============================================================================
# CHW Cursor 培訓 — API 設定範本
# =============================================================================
# 用法：複製此檔為 config/.env，填入真實 Key
#       cp config/.env.example config/.env
# ⚠️ 切勿 commit 含真實 Key 的 .env 到 Git
# =============================================================================


# -----------------------------------------------------------------------------
# API Keys（必填）
# -----------------------------------------------------------------------------

# Google Gemini — 申請：https://aistudio.google.com/apikey
# 格式：AIzaSy...
GEMINI_API_KEY=AIzaSy_xxxxxxxxxxxxxxxx

# DeepSeek — 申請：https://platform.deepseek.com （需充值）
# 格式：sk-...
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx

# DeepSeek OpenAI 兼容接口（Cursor Override Base URL 用）
DEEPSEEK_BASE_URL=https://api.deepseek.com


# -----------------------------------------------------------------------------
# 本課程預設 Model（Cursor → Settings → Models → Add model 後啟用）
# -----------------------------------------------------------------------------

# 活動一 Minutes、活動二 Watchdog → 用 DeepSeek
DEEPSEEK_MODEL=deepseek-v4-flash

# 活動三 MARP + AI 插圖 → 用 Gemini
GEMINI_MODEL=gemini-2.5-flash


# =============================================================================
# Gemini 可選 Model 一覽
# （將下面其中一個 model ID 複製去 Cursor「Add model」，或改 GEMINI_MODEL）
# =============================================================================
#
# ── 推薦（2026 穩定版）──────────────────────────────────────────────────────
#
# gemini-2.5-flash
#   均衡首選。快、平、支援 reasoning + 多模態（文字/圖/音/視頻）。
#   適合：活動三簡報、一般 Agent、長文 minutes（備用）。
#   ★ 本課程活動三預設
#
# gemini-2.5-flash-lite
#   最快、最平。適合大量短 request、簡單改文、試 prompt。
#   限制：複雜推理同長文較 2.5-flash 弱。
#
# gemini-2.5-pro
#   最強 Gemini 2.5。複雜推理、長文分析、精細寫作。
#   適合：重要會議紀錄覆核、複雜行政文件。
#   限制：較慢、較貴、free tier quota 較緊。
#
# ── Gemini 3 系列（較新，部分為 Preview）────────────────────────────────────
#
# gemini-3-flash
#   新一代 Flash。性能接近 Pro、成本仍低。
#   適合：想試最新 model 的 Agent 任務。
#
# gemini-3.5-flash
#   針對 Agent、coding、 sustained 任務優化。
#   適合：活動二 Vibe Coding（可試）。
#
# gemini-3.1-pro-preview
#   頂級推理同 agentic 能力（Preview）。
#   適合：最難的分析任務；課堂 demo 可略過。
#
# ── 圖片 / 多模態專用（活動三 AI 插圖）────────────────────────────────────────
#
# gemini-2.5-flash
#   同一 model 已支援 image input/output，活動三一般已夠用。
#
# imagen-4.0-generate-001
#   純文字→圖片（Imagen 4）。畫質高，適合簡報插圖。
#   注意：Cursor Agent 未必直接支援；可能需 API script。
#
# gemini-2.0-flash-preview-image-generation
#   舊版圖片生成（Preview）。新 project 建議用 2.5-flash 或 Imagen 4。
#
# ── 已棄用（仍可能用到，但不建議新 project）──────────────────────────────────
#
# gemini-2.0-flash
#   上一代 Flash。Google 已標記 Deprecated，請改用 gemini-2.5-flash。
#
# gemini-2.0-flash-lite
#   上一代 Lite。已 Deprecated，請改用 gemini-2.5-flash-lite。
#
# gemini-1.5-flash
# gemini-1.5-pro
#   舊版。部分帳號仍可用，建議 migrate 到 2.5。


# =============================================================================
# DeepSeek 可選 Model 一覽
# （將下面其中一個 model ID 複製去 Cursor「Add model」，或改 DEEPSEEK_MODEL）
# =============================================================================
#
# ── 現行（2026 主力）────────────────────────────────────────────────────────
#
# deepseek-v4-flash
#   最新 Flash。快、極平、128K–1M context、支援 tool calls + JSON。
#   支援 non-thinking（快）同 thinking（慢但準）兩種 mode。
#   ★ 本課程活動一、二預設
#
# deepseek-v4-pro
#   最強 DeepSeek。複雜推理、大型 coding 任務。
#   限制：較慢、較貴； concurrency 上限較低（500）。
#
# ── 舊名稱（仍可用，但官方計劃棄用）──────────────────────────────────────────
#
# deepseek-chat
#   ≡ deepseek-v4-flash 的 non-thinking mode（兼容舊設定）。
#   若你 handout 寫 deepseek-chat，課堂仍 work，但新 project 請改 v4-flash。
#
# deepseek-reasoner
#   ≡ deepseek-v4-flash 的 thinking mode（兼容舊設定）。
#   適合：複雜邏輯、數學、多步推理；活動一 minutes 要極準可試。
#   限制：明顯較慢，輸出 token 較多（較貴）。


# =============================================================================
# 本課程 Model 分工速查
# =============================================================================
#
# | 活動           | 建議 Model              | 原因                    |
# |----------------|-------------------------|-------------------------|
# | 活動一 Minutes | deepseek-v4-flash       | 長文穩定、平、快        |
# | 活動二 Watchdog| deepseek-v4-flash       | 寫 Python 佳            |
# | 活動三 MARP    | gemini-2.5-flash        | 多模態、簡報插圖        |
#
# 進階替換：
#   活動一要更準 → deepseek-reasoner 或 deepseek-v4-pro
#   活動三要更靚圖 → gemini-2.5-pro 或 imagen-4.0-generate-001
#   想慳錢試玩 → gemini-2.5-flash-lite + deepseek-v4-flash


# =============================================================================
# Cursor 設定提示
# =============================================================================
#
# Gemini：
#   Settings → Models → Google API Key → 貼 GEMINI_API_KEY
#   Add model → 貼上面其中一個 gemini-* 名稱 → 啟用
#
# DeepSeek：
#   Settings → Models → OpenAI API Key → 貼 DEEPSEEK_API_KEY（不是 OpenAI！）
#   Override Base URL → https://api.deepseek.com （不要加 /v1）
#   Add model → 貼上面其中一個 deepseek-* 名稱 → 啟用
#
# 詳見：handouts/01-cursor-setup-guide.md
# 申請：handouts/05-api-key-application-guide.md
