import tkinter as tk
from tkinter import messagebox, simpledialog
import random
import time

# ========== 遊戲設定 ==========
root = tk.Tk()
root.title("✨ 超歡樂過三關 ✨")
root.resizable(False, False)

# 棋盤
board = [[None]*3 for _ in range(3)]
buttons = []
current_player = "X"  # 玩家X，電腦O

# 加分趣味系統
player_score = 0
com_score = 0
combo = 0
last_win = ""

# 難度
difficulty = "普通"

# ========== 勝利判斷 ==========
def check_winner():
    for i in range(3):
        if board[i][0]==board[i][1]==board[i][2]!=None:
            return board[i][0]
        if board[0][i]==board[1][i]==board[2][i]!=None:
            return board[0][i]
    if board[0][0]==board[1][1]==board[2][2]!=None:
        return board[0][0]
    if board[0][2]==board[1][1]==board[2][0]!=None:
        return board[0][2]
    if all(c!=None for r in board for c in r):
        return "平局"
    return None

# ========== Minimax 無敵AI ==========
def minimax(is_max):
    res = check_winner()
    if res=="O": return 1
    if res=="X": return -1
    if res=="平局": return 0

    if is_max:
        best = -float("inf")
        for i in range(3):
            for j in range(3):
                if board[i][j]==None:
                    board[i][j]="O"
                    s=minimax(False)
                    board[i][j]=None
                    if s>best:best=s
        return best
    else:
        best = float("inf")
        for i in range(3):
            for j in range(3):
                if board[i][j]==None:
                    board[i][j]="X"
                    s=minimax(True)
                    board[i][j]=None
                    if s<best:best=s
        return best

def computer_best():
    best,move = -float("inf"),None
    for i in range(3):
        for j in range(3):
            if board[i][j]==None:
                board[i][j]="O"
                s=minimax(False)
                board[i][j]=None
                if s>best:
                    best=s
                    move=(i,j)
    return move

# ========== 電腦行為 ==========
def computer_move():
    global current_player
    empty = [(i,j) for i in range(3) for j in range(3) if board[i][j]==None]
    if not empty:return

    if difficulty=="簡單":
        r,c = random.choice(empty)
    elif difficulty=="困難":
        r,c = computer_best()
    else:
        if random.random()<0.4:
            r,c = computer_best()
        else:
            r,c = random.choice(empty)

    board[r][c]="O"
    buttons[r][c].config(text="O",fg="#2980b9")
    check_end()

# ========== 連擊 & 計分 ==========
def add_score(winner):
    global player_score, com_score, combo, last_win
    base = 100

    if winner==last_win:
        combo +=1
    else:
        combo = 1
    last_win = winner

    add = base * combo

    if winner=="X":
        player_score += add
        msg = f"🎉 玩家得分 +{add} (連擊 {comcombo} 倍)"
    else:
        com_score += add
        msg = f"💻 電腦得分 +{add} (連擊 {combo} 倍)"

    score_label.config(text=f"玩家: {player_score}  |  電腦: {com_score}")
    combo_label.config(text=f"連擊 ×{combo}")
    root.title(f"✨ 過三關 — {msg}")

# ========== 遊戲結束判斷 ==========
def check_end():
    global current_player
    res = check_winner()
    if not res:
        current_player = "X"
        return

    if res=="平局":
        messagebox.showinfo("結束","⚖️ 平局！")
    else:
        add_score(res)
        if res=="X":
            messagebox.showinfo("勝利","🎉 你贏了！")
        else:
            messagebox.showinfo("失敗","💻 電腦獲勝！")

    reset_board()

# ========== 重置棋盤 ==========
def reset_board():
    global board, current_player
    board = [[None]*3 for _ in range(3)]
    for i in range(3):
        for j in range(3):
            buttons[i][j].config(text="",bg="#ecf0f1")
    current_player = "X"

# ========== 玩家點擊 ==========
def click(r,c):
    global current_player
    if board[r][c]!=None or current_player!="X":
        return
    board[r][c] = "X"
    buttons[r][c].config(text="X",fg="#e74c3c")
    check_end()
    if check_winner()==None:
        current_player="O"
        root.after(500,computer_move)

# ========== 難度切換 ==========
def set_diff(d):
    global difficulty
    difficulty = d
    diff_lbl.config(text=f"難度: {difficulty}")

# ========== 介面建立 ==========
# 標題
tk.Label(root,text="🎮 超歡樂過三關 🎮",font=("Arial",16,"bold")).grid(row=0,column=0,columnspan=3,pady=5)

# 計分
score_label = tk.Label(root,text=f"玩家: {player_score}  |  電腦: {com_score}",font=("Arial",12))
score_label.grid(row=1,column=0,columnspan=3)

combo_label = tk.Label(root,text="連擊 ×1",font=("Arial",11),fg="#e67e22")
combo_label.grid(row=2,column=0,columnspan=3)

# 難度
diff_lbl = tk.Label(root,text=f"難度: {difficulty}")
diff_lbl.grid(row=3,column=0,columnspan=3,pady=2)

f = tk.Frame(root)
f.grid(row=4,column=0,columnspan=3)
tk.Button(f,text="簡單",command=lambda:set_diff("簡單")).pack(side=tk.LEFT,padx=3)
tk.Button(f,text="普通",command=lambda:set_diff("普通")).pack(side=tk.LEFT,padx=3)
tk.Button(f,text="困難",command=lambda:set_diff("困難")).pack(side=tk.LEFT,padx=3)

# 棋盤
for i in range(3):
    row = []
    for j in range(3):
        btn = tk.Button(root,text="",font=("Arial",36,"bold"),width=2,height=1,
                        bg="#ecf0f1",activebackground="#bdc3c7",bd=3)
        btn.config(command=lambda r=i,c=j:click(r,c))
        btn.grid(row=i+5,column=j,padx=4,pady=4)
        row.append(btn)
    buttons.append(row)

root.mainloop()