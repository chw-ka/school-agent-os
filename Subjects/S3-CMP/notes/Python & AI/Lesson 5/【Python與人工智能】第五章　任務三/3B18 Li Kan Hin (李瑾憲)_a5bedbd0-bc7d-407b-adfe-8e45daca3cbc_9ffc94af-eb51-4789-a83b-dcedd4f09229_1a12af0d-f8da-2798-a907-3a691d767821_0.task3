import tkinter as tk
from tkinter import messagebox
import random
import math

class UltimateTicTacToe:
    def __init__(self, root):
        self.root = root
        self.root.title("Ultimate Tic-Tac-Toe v3.0")
        self.root.configure(bg="#2C3E50") # 深色現代感背景

        # 遊戲數據
        self.human = "X"
        self.ai = "O"
        self.scores = {"X": 0, "O": 0, "Draw": 0}
        self.current_player = self.human
        self.board = [[None for _ in range(3)] for _ in range(3)]
        self.buttons = [[None for _ in range(3)] for _ in range(3)]
        
        # 計時器設定
        self.time_limit = 5
        self.remaining_time = self.time_limit
        self.timer_job = None

        self.setup_ui()
        self.start_timer()

    def setup_ui(self):
        # 頂部：積分板
        self.score_frame = tk.Frame(self.root, bg="#2C3E50")
        self.score_frame.pack(pady=10)
        
        self.score_label = tk.Label(
            self.score_frame, 
            text=f"玩家 (X): {self.scores['X']}  |  AI (O): {self.scores['O']}  |  平局: {self.scores['Draw']}",
            fg="#ECF0F1", bg="#2C3E50", font=("Microsoft JhengHei", 12, "bold")
        )
        self.score_label.pack()

        # 中間：狀態與計時
        self.status_label = tk.Label(
            self.root, text="準備好了嗎？你的回合！", 
            fg="#F1C40F", bg="#2C3E50", font=("Microsoft JhengHei", 14, "bold")
        )
        self.status_label.pack(pady=5)

        self.timer_label = tk.Label(
            self.root, text=f"剩餘時間: {self.remaining_time}s", 
            fg="#E74C3C", bg="#2C3E50", font=("Consolas", 16, "bold")
        )
        self.timer_label.pack()

        # 棋盤 Frame
        self.game_frame = tk.Frame(self.root, bg="#34495E", bd=5, relief="ridge")
        self.game_frame.pack(padx=20, pady=20)

        for r in range(3):
            for c in range(3):
                btn = tk.Button(
                    self.game_frame, text="", font=('Arial', 36, 'bold'),
                    width=4, height=1, bg="#ECF0F1", fg="#2C3E50",
                    activebackground="#BDC3C7", relief="flat",
                    command=lambda row=r, col=c: self.player_action(row, col)
                )
                btn.grid(row=r, column=c, padx=5, pady=5)
                self.buttons[r][c] = btn

    # --- 邏輯核心 ---
    def start_timer(self):
        if self.timer_job:
            self.root.after_cancel(self.timer_job)
        
        if self.current_player == self.human:
            self.remaining_time = self.time_limit
            self.update_timer_display()

    def update_timer_display(self):
        self.timer_label.config(text=f"剩餘時間: {self.remaining_time}s")
        if self.remaining_time > 0:
            self.remaining_time -= 1
            self.timer_job = self.root.after(1000, self.update_timer_display)
        else:
            # 時間到，隨機下一格
            self.status_label.config(text="超時！電腦幫你隨機下一棋！")
            r, c = random.choice([(r, c) for r in range(3) for c in range(3) if self.board[r][c] is None])
            self.player_action(r, c)

    def player_action(self, r, c):
        if self.board[r][c] is not None or self.current_player != self.human:
            return

        if self.timer_job:
            self.root.after_cancel(self.timer_job)
        
        self.make_move(r, c, self.human)
        if not self.check_end():
            self.current_player = self.ai
            self.status_label.config(text="AI 思考中...", fg="#E67E22")
            self.root.after(600, self.ai_action)

    def ai_action(self):
        move = self.get_best_move()
        if move:
            self.make_move(move[0], move[1], self.ai)
            if not self.check_end():
                self.current_player = self.human
                self.status_label.config(text="你的回合！快點！", fg="#F1C40F")
                self.start_timer()

    def make_move(self, r, c, player):
        self.board[r][c] = player
        color = "#3498DB" if player == "X" else "#E74C3C"
        self.buttons[r][c].config(text=player, fg=color)

    # --- Minimax 演算法 ---
    def get_best_move(self):
        best_score = -math.inf
        move = None
        for r in range(3):
            for c in range(3):
                if self.board[r][c] is None:
                    self.board[r][c] = self.ai
                    score = self.minimax(self.board, 0, False)
                    self.board[r][c] = None
                    if score > best_score:
                        best_score = score
                        move = (r, c)
        return move

    def minimax(self, board, depth, is_maximizing):
        winner = self.check_winner_logic()
        if winner == self.ai: return 10 - depth
        if winner == self.human: return depth - 10
        if self.is_full(): return 0

        if is_maximizing:
            best_score = -math.inf
            for r in range(3):
                for c in range(3):
                    if board[r][c] is None:
                        board[r][c] = self.ai
                        score = self.minimax(board, depth + 1, False)
                        board[r][c] = None
                        best_score = max(score, best_score)
            return best_score
        else:
            best_score = math.inf
            for r in range(3):
                for c in range(3):
                    if board[r][c] is None:
                        board[r][c] = self.human
                        score = self.minimax(board, depth + 1, True)
                        board[r][c] = None
                        best_score = min(score, best_score)
            return best_score

    def check_winner_logic(self):
        b = self.board
        for i in range(3):
            if b[i][0] == b[i][1] == b[i][2] and b[i][0]: return b[i][0]
            if b[0][i] == b[1][i] == b[2][i] and b[0][i]: return b[0][i]
        if b[0][0] == b[1][1] == b[2][2] and b[0][0]: return b[0][0]
        if b[0][2] == b[1][1] == b[2][0] and b[0][2]: return b[0][2]
        return None

    def is_full(self):
        return all(self.board[r][c] is not None for r in range(3) for c in range(3))

    def check_end(self):
        winner = self.check_winner_logic()
        if winner:
            self.highlight_winner(winner)
            self.scores[winner] += 1
            messagebox.showinfo("Game Over", f"玩家 {winner} 獲勝！")
            self.reset_game()
            return True
        if self.is_full():
            self.scores["Draw"] += 1
            messagebox.showinfo("Game Over", "平局！")
            self.reset_game()
            return True
        return False

    def highlight_winner(self, winner):
        # 簡單的獲勝閃爍特效
        color = "#2ECC71" # 贏家綠色
        for r in range(3):
            for c in range(3):
                if self.board[r][c] == winner:
                    self.buttons[r][c].config(bg=color)

    def reset_game(self):
        if self.timer_job:
            self.root.after_cancel(self.timer_job)
        self.board = [[None for _ in range(3)] for _ in range(3)]
        self.current_player = self.human
        for r in range(3):
            for c in range(3):
                self.buttons[r][c].config(text="", bg="#ECF0F1")
        self.score_label.config(text=f"玩家 (X): {self.scores['X']}  |  AI (O): {self.scores['O']}  |  平局: {self.scores['Draw']}")
        self.start_timer()

if __name__ == "__main__":
    root = tk.Tk()
    game = UltimateTicTacToe(root)
    root.mainloop()