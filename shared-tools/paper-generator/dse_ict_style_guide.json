  "mcq_stem_templates": [
    "下列哪一項……？",
    "下列哪項……？",
    "下列哪些……？",
    "下列哪項（些）……？",
    "下列哪句關於……是正確的？",
    "下列哪項（些）關於……的句子是正確的？",
    "下列哪項（些）……最恰當？",
    "下列哪項……最可能……？",
    "下列何者最接近……？",
    "以下哪項……？",
    "以下算法的輸出是什麼？",
    "下列算法的輸出是什麼？",
    "測試下列算法段的邊際個案是什麼？",
    "比較……，下列敘述何者正確？",
    "為什麼……？",
    "……的好處是什麼？",
    "……時，需要採用下列哪一組……？",
    "細看以下……：",
    "考慮以下……：",
    "參考以下……，回答題……",
    "在以下……中，……"
  ],
  "mcq_combo_item_format": {
    "intro": "題幹後列 (1)(2)(3)，再問「下列哪項（些）……」",
    "item_prefix": "\t(1)\t",
    "examples": [
      "此網上登記會涉及下列哪（些）項目？\n(1) 數據驗證\n(2) 數據壓縮\n(3) 數據有效性檢驗",
      "下列關於……的敘述，何者較正確？\n(1) ……\n(2) ……\n(3) ……\n（請以「最合理」為準選擇答案）"
    ]
  },
  "mcq_option_templates": {
    "combo_1_and_3": [
      "A. 只有 (1)",
      "B. 只有 (2)",
      "C. 只有 (1) 和 (3)",
      "D. 只有 (2) 和 (3)"
    ],
    "combo_all_four": [
      "A. 只有 (1) 和 (2)",
      "B. 只有 (1) 和 (3)",
      "C. 只有 (2) 和 (3)",
      "D. (1)、(2) 和 (3)"
    ],
    "order_rule": "單項 (1)→(2)→(3)，再雙項組合，最後「皆是／全部」"
  },
  "structured_question_verbs": {
    "section_a_b_short": ["列出", "說明", "解釋", "比較", "舉出", "指出"],
    "section_b_longer": ["描述", "建議", "討論", "評論"],
    "section_c_technical": [
      "完成", "寫出", "繪製", "設計", "建構",
      "指出……的主鍵（PK）與外鍵（FK）",
      "寫出一條 SQL……",
      "描述如何計算……",
      "舉出每個……可提供的服務"
    ],
    "marking_suffix": "\t( n 分)"
  },
  "dse_vs_school_paper_alignment": {
    "prefer_dse": [
      "用「下列哪項（些）」而非「下列哪一個選項」",
      "組合題用「只有 (1)」「(1)、(2) 和 (3)」",
      "技術詞首次出現加英文括號",
      "算法題用「下列／以下算法的輸出是什麼」",
      "試算表題用「目標搜尋」「樞紐分析表」「儲存格參照」",
      "數據庫題用「寫出一條 SQL」「實體關係圖（ERD）」「主鍵／外鍵」"
    ],
    "avoid": [
      "過長英文題幹",
      "沒有 (1)(2)(3) 卻用四個獨立敘述的 pseudo-combo 題",
      "與 DSE 用語不一致的翻譯（如 database table → 用「數據庫表」）"
    ]
  },
  "sample_stems_for_core_abd_mcq": [
