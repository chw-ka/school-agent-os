# Copy to .env and fill in your keys (never commit .env).
#   cp .env.example .env
#
# LLM guides:
#   DeepSeek (recommended for solve_review): docs/DEEPSEEK_API.md
#   Gemini: docs/GOOGLE_API_KEY.md

# --- DeepSeek (solve_review / solve_repair / pdf-engine) ---
DSE_ICT_LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
# DSE_ICT_LLM_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# --- Gemini (Google AI Studio) ---
# GOOGLE_API_KEY=
# GEMINI_API_KEY=
# DSE_ICT_LLM_PROVIDER=gemini
# DSE_ICT_LLM_MODEL=gemini-2.0-flash

# --- OpenAI or other OpenAI-compatible APIs ---
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Microsoft Graph (shared-tools/marking Teams connector) ---
# MS_CLIENT_ID=
# MS_TENANT_ID=
# MS_SECRET_VALUE=
