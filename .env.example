# Copy to .env and fill in your keys (never commit .env).
#   cp .env.example .env
#
# See docs/GOOGLE_API_KEY.md

# Gemini (Google AI Studio) — used by pdf-engine LLM refinement
GOOGLE_API_KEY=

# Optional aliases / overrides
# GEMINI_API_KEY=
# DSE_ICT_LLM_PROVIDER=gemini
# DSE_ICT_LLM_MODEL=gemini-2.0-flash

# OpenAI-compatible (if you use --provider openai)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
